{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 4,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "time",
          "style": "diamond",
          "leading_diamond": "",
          "foreground": "#000000",
          "background": "#e05d5d",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": "  {{ .CurrentDate | date .Format }} <#e05d5d,#161a1f></><#161a1f,#e6c07b></>"
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "",
          "foreground": "#000000",
          "background": "#e6c07b",
          "properties": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_separator_icon": "/",
            "hide_root_location": false,
            "folder_icon": "",
            "home_icon": "~"
          },
          "template": " {{ .Path }}<#e6c07b,#161a1f></><#161a1f,#5b3f86></>"
        },
        {
          "type": "git",
          "style": "diamond",
          "trailing_diamond": "",
          "foreground": "#ffffff",
          "background": "#5b3f86",
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true,
            "branch_icon": " "
          },
          "template": " {{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "diamond",
          "leading_diamond": "",
          "trailing_diamond": "",
          "foreground": "#000000",
          "background": "#79c7e3",
          "properties": {
            "threshold": 0,
            "always_enabled": true
          },
          "template": " 󱎫 {{ .FormattedMs }} "
        }
      ]
    }
  ]
}
